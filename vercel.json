{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/finances",
      "destination": "https://myfinances-sepia-sigma.vercel.app/finances/index.html"
    },
    {
      "source": "/finances/",
      "destination": "https://myfinances-sepia-sigma.vercel.app/finances/index.html"
    },
    {
      "source": "/finances/:path+",
      "destination": "https://myfinances-sepia-sigma.vercel.app/finances/:path+"
    },
    {
      "source": "/api/eb",
      "destination": "https://myfinances-sepia-sigma.vercel.app/api/eb"
    },
    {
      "source": "/perf",
      "destination": "https://myperf-six.vercel.app/perf/index.html"
    },
    {
      "source": "/perf/",
      "destination": "https://myperf-six.vercel.app/perf/index.html"
    },
    {
      "source": "/perf/:path+",
      "destination": "https://myperf-six.vercel.app/perf/:path+"
    },
    {
      "source": "/raveloc",
      "destination": "https://myraveloc.vercel.app/raveloc/index.html"
    },
    {
      "source": "/raveloc/",
      "destination": "https://myraveloc.vercel.app/raveloc/index.html"
    },
    {
      "source": "/raveloc/:path+",
      "destination": "https://myraveloc.vercel.app/raveloc/:path+"
    },
    {
      "source": "/((?!api/|finances|perf|raveloc).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!finances|perf|raveloc|api).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.anthropic.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-weekly",
      "schedule": "0 17 * * 0"
    }
  ]
}
