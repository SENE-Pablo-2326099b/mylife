{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mylife/kit": ["packages/kit/src/index.ts"],
      "@mylife/lumen": ["packages/lumen/src/index.ts"],
      "@mylife/core/*": ["packages/sync-client/src/*"],
      "@legacy/*": ["web/src/*"]
    }
  },
  "include": ["api", "server", "tests", "packages/sync-client", "packages/lumen", "packages/training"]
}
