{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/", "destination": "/perf/", "permanent": false }],
  "rewrites": [{ "source": "/perf/((?!_expo/|assets/).*)", "destination": "/perf/index.html" }],
  "headers": [
    { "source": "/perf/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/perf/_expo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
