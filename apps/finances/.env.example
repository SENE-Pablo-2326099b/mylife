# Copie ce fichier en .env.local pour le développement (jamais commité).
# Les mêmes variables sont à définir dans Vercel / Netlify (Settings → Environment variables).

# ID de l'application Enable Banking (Control Panel → Applications)
EB_APP_ID=
# Clé privée RSA de l'application : soit le contenu PEM (avec \n), soit en base64…
EB_PRIVATE_KEY=
# …soit, en local uniquement, le chemin vers le fichier .pem
EB_PRIVATE_KEY_PATH=
# Mot de passe long et aléatoire, à saisir une fois dans l'app (Réglages → Connexion bancaire)
BRIDGE_PASSWORD=
# Facultatif : URL(s) de retour autorisées, séparées par des virgules
# EB_REDIRECT_URLS=https://budget-dodge.vercel.app/connexion/retour
