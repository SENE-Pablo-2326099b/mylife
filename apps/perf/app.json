{
  "expo": {
    "name": "MyPerf",
    "slug": "myperf",
    "platforms": [
      "web"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myperf",
    "userInterfaceStyle": "automatic",
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "MyPerf",
      "shortName": "MyPerf",
      "lang": "fr",
      "themeColor": "#0C0C0F",
      "backgroundColor": "#0C0C0F"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/perf"
    },
    "backgroundColor": "#0C0C0F"
  }
}
