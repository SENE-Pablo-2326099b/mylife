{
  "name": "mylife",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "vendor": "node scripts/vendor.mjs",
    "deploy": "npx --yes vercel@61.1.0 deploy --prod --yes",
    "local": "vite-node scripts/local.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "lint": "eslint web/src",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "setup": "npm install && npm --prefix apps/finances install && npm --prefix apps/perf install && npm --prefix apps/raveloc install",
    "build:all": "npm run vendor && npm run build && npm --prefix apps/finances run build && npm --prefix apps/raveloc run build && npm --prefix apps/perf run build:web",
    "test:all": "npm test && npm --prefix apps/finances test && npm --prefix apps/raveloc test && npm --prefix apps/perf test -- --silent",
    "e2e:all": "npm --prefix apps/finances run e2e && npm --prefix apps/raveloc run e2e && npm run e2e",
    "deploy:all": "npm --prefix apps/finances run deploy && npm --prefix apps/perf run deploy:web && npm --prefix apps/raveloc run deploy && npm run deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@vercel/functions": "3.9.11",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.16.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/sora": "5.2.8",
    "@fontsource/space-grotesk": "^5.3.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "^20.17.10",
    "@types/pg": "8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "framer-motion": "11.18.2",
    "globals": "^15.13.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "5.6.0",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
