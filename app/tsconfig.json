{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@mylife/kit": ["../packages/kit/src/index.ts"],
      "@mylife/kit/kit.css": ["../packages/kit/src/kit.css"],
      "@mylife/lumen": ["../packages/lumen/src/index.ts"],
      "@mylife/training": ["../packages/training/src/index.ts"],
      "@mylife/core/*": ["../packages/sync-client/src/*"],
      "@legacy/*": ["../web/src/*"]
    }
  },
  "include": ["src", "../packages/kit/src", "../packages/training/src", "../web/src/copilot.ts", "../web/src/sortieDigest.ts", "../web/src/spaces.ts", "../web/src/spaceSync.ts"]
}
